APP_NAME="Stupid Log"
APP_VERSION=1.0.1
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080
COMPOSE_PROJECT_NAME=stupid-log-8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=stupid_log
